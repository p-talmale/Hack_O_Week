<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AuraWeather | Precision Forecast</title>
    <style>
        :root {
            --glass: rgba(255, 255, 255, 0.1);
            --glass-border: rgba(255, 255, 255, 0.2);
            --accent: #00f2fe;
            --bg-gradient: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        }

        body {
            font-family: 'Inter', -apple-system, sans-serif;
            background: var(--bg-gradient);
            background-attachment: fixed;
            color: white;
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 2rem;
        }

        .search-container {
            width: 100%;
            max-width: 600px;
            margin-bottom: 3rem;
            position: relative;
        }

        input {
            width: 100%;
            padding: 15px 25px;
            border-radius: 50px;
            border: 1px solid var(--glass-border);
            background: var(--glass);
            color: white;
            font-size: 1.1rem;
            backdrop-filter: blur(10px);
            outline: none;
            transition: all 0.3s;
        }

        input:focus { border-color: var(--accent); box-shadow: 0 0 15px rgba(0, 242, 254, 0.3); }

        .dashboard {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 2rem;
            width: 100%;
            max-width: 1200px;
        }

        .card {
            background: var(--glass);
            backdrop-filter: blur(15px);
            border: 1px solid var(--glass-border);
            border-radius: 32px;
            padding: 2rem;
            position: relative;
            overflow: hidden;
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .card:hover { transform: translateY(-10px); }

        .card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(0, 242, 254, 0.05) 0%, transparent 70%);
            pointer-events: none;
        }

        .city-header { display: flex; justify-content: space-between; align-items: center; }
        .temp-main { font-size: 4.5rem; font-weight: 800; margin: 1rem 0; letter-spacing: -2px; }
        .condition-text { text-transform: uppercase; letter-spacing: 2px; font-size: 0.8rem; color: var(--accent); }

        .forecast-strip {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            background: rgba(0,0,0,0.2);
            border-radius: 20px;
            padding: 1rem;
            margin-top: 1.5rem;
        }

        .day-cell { text-align: center; }
        .day-cell label { display: block; font-size: 0.7rem; color: #94a3b8; margin-bottom: 5px; }
        .day-cell span { font-weight: 600; font-size: 1.1rem; }

        .badge {
            padding: 5px 12px;
            background: var(--accent);
            color: #0f172a;
            border-radius: 12px;
            font-size: 0.7rem;
            font-weight: 700;
        }

        .loading-spinner {
            border: 4px solid rgba(255,255,255,0.1);
            border-left-color: var(--accent);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body>

<header style="text-align: center; margin-bottom: 2rem;">
    <h1 style="font-size: 3rem; margin: 0;">AURA<span>WEATHER</span></h1>
    <p style="color: #94a3b8;">Hyper-local 2026 Predictive Forecast</p>
</header>

<div class="search-container">
    <input type="text" id="citySearch" placeholder="Search any city (e.g. Paris, Dubai, Sydney)..." onkeypress="handleSearch(event)">
</div>

<div class="dashboard" id="dashboard">
    <div class="loading-spinner"></div>
</div>

<script>
    const dashboard = document.getElementById('dashboard');
    const defaultCities = ['New York', 'London', 'Tokyo'];

    // 1. Initialize App
    async function init() {
        dashboard.innerHTML = '';
        // Try to get user location first
        navigator.geolocation.getCurrentPosition(
            pos => fetchByCoords(pos.coords.latitude, pos.coords.longitude, "Your Location"),
            err => console.log("Location denied")
        );
        
        defaultCities.forEach(city => fetchByCityName(city));
    }

    async function fetchByCityName(city) {
        // Step 1: Geocoding (Convert city name to lat/long)
        const geoRes = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${city}&count=1`);
        const geoData = await geoRes.json();
        if (!geoData.results) return;
        const { latitude, longitude, name } = geoData.results[0];
        fetchByCoords(latitude, longitude, name);
    }

    async function fetchByCoords(lat, lon, label) {
        // Step 2: Fetch Weather (Current, Yesterday, Tomorrow)
        // Note: Open-Meteo allows past_days=1 to get yesterday
        const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&daily=temperature_2m_max,weathercode&timezone=auto&past_days=1`;
        
        const res = await fetch(url);
        const data = await res.json();
        renderCard(data, label);
    }

    function renderCard(data, label) {
        const current = data.current_weather;
        const daily = data.daily;
        
        const card = document.createElement('div');
        card.className = 'card';
        
        // Weather Code mapping (Simplified)
        const weatherDesc = current.weathercode < 3 ? 'Clear' : current.weathercode < 60 ? 'Cloudy' : 'Rainy';

        card.innerHTML = `
            <div class="city-header">
                <span class="condition-text">${weatherDesc}</span>
                ${label === "Your Location" ? '<span class="badge">LOCAL</span>' : ''}
            </div>
            <h2 style="margin: 5px 0;">${label}</h2>
            <div class="temp-main">${Math.round(current.temperature)}°</div>
            
            <div class="forecast-strip">
                <div class="day-cell">
                    <label>Yesterday</label>
                    <span>${Math.round(daily.temperature_2m_max[0])}°</span>
                </div>
                <div class="day-cell">
                    <label>Today</label>
                    <span style="color: var(--accent)">${Math.round(daily.temperature_2m_max[1])}°</span>
                </div>
                <div class="day-cell">
                    <label>Next Day</label>
                    <span>${Math.round(daily.temperature_2m_max[2])}°</span>
                </div>
            </div>
            
            <div style="margin-top: 15px; font-size: 0.8rem; color: #94a3b8;">
                Wind: ${current.windspeed} km/h • Code: ${current.weathercode}
            </div>
        `;
        dashboard.prepend(card);
    }

    function handleSearch(e) {
        if (e.key === 'Enter') {
            fetchByCityName(e.target.value);
            e.target.value = '';
        }
    }

    init();
</script>

</body>
</html>








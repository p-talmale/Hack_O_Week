            flex: 0 0 65px;
            text-align: center;
            background: rgba(255,255,255,0.03);
            padding: 10px;
            border-radius: 15px;
        }

        .hour-temp { font-weight: 700; color: var(--accent); }
    </style>
</head>
<body>

    <header>
        <h1>Aura<span>Weather</span></h1>
        <p>Dynamic Date-Based Intelligence</p>
    </header>

    <div class="controls">
        <div class="input-group">
            <label>Location</label>
            <input type="text" id="cityInput" placeholder="Enter city..." value="New York">
        </div>
        <div class="input-group">
            <label>Pick Date</label>
            <input type="date" id="dateInput">
        </div>
        <button id="fetchBtn" onclick="updateWeather()">Show Weather</button>
    </div>

    <div class="dashboard" id="mainContainer">
        </div>

<script>
    // Set default date to today on load
    window.onload = () => {
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('dateInput').value = today;
        updateWeather();
    };

    async function updateWeather() {
        const city = document.getElementById('cityInput').value;
        const date = document.getElementById('dateInput').value;
        const container = document.getElementById('mainContainer');

        if (!city || !date) return alert("Please enter city and select a date");

        container.innerHTML = '<div style="text-align: center;">Querying Archive...</div>';

        try {
            // 1. Get Coordinates
            const geoRes = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${city}&count=1`);
            const geoData = await geoRes.json();
            if (!geoData.results) throw new Error("City not found");
            const { latitude, longitude, name, country } = geoData.results[0];

            // 2. Decide API: History or Forecast
            const selectedDate = new Date(date);
            const today = new Date();
            today.setHours(0,0,0,0);

            let url;
            if (selectedDate < today) {
                // Archive API
                url = `https://archive-api.open-meteo.com/v1/archive?latitude=${latitude}&longitude=${longitude}&start_date=${date}&end_date=${date}&hourly=temperature_2m&timezone=auto`;
            } else {
                // Forecast API
                url = `https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&start_date=${date}&end_date=${date}&hourly=temperature_2m&timezone=auto`;
            }

            const wRes = await fetch(url);
            const wData = await wRes.json();
            renderCard(wData, name, country, date);

        } catch (e) {
            container.innerHTML = `<p style="text-align:center; color: #ff4b2b;">${e.message}</p>`;
        }
    }

    function renderCard(data, name, country, date) {
        const temps = data.hourly.temperature_2m;
        // Average temp for the day display
        const avgTemp = Math.round(temps.reduce((a, b) => a + b, 0) / temps.length);

        const hourlyHTML = temps.map((temp, i) => `
            <div class="hour-item">
                <span style="font-size: 0.7rem; color: #94a3b8; display: block;">${i}:00</span>
                <span class="hour-temp">${Math.round(temp)}°</span>
            </div>
        `).join('');

        document.getElementById('mainContainer').innerHTML = `
            <div class="card">
                <div class="card-top">
                    <div>
                        <h2 style="margin:0">${name}</h2>
                        <span style="color:#94a3b8">${country}</span>
                    </div>
                    <div class="date-badge">${date}</div>
                </div>

                <div style="display: flex; align-items: baseline; gap: 15px;">
                    <div class="main-temp">${avgTemp}°</div>
                    <div style="color: #94a3b8; font-size: 1.1rem;">Daily Avg</div>
                </div>

                <div class="timeline-container">
                    <span style="font-size: 0.8rem; color: var(--accent); text-transform: uppercase; margin-bottom: 15px; display: block;">
                        Hourly Timeline for ${date}
                    </span>
                    <div class="timeline-scroll">
                        ${hourlyHTML}
                    </div>
                </div>
            </div>
        `;
    }
</script>
</body>
</html>

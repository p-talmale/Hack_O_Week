        header { text-align: center; margin-bottom: 20px; }
        h1 { font-weight: 800; letter-spacing: -1px; margin: 0; }
        h1 span { color: var(--accent); }

        .controls {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            width: 100%;
            max-width: 700px;
            margin-bottom: 30px;
            justify-content: center;
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
            flex: 1;
            min-width: 200px;
        }

        label { font-size: 0.75rem; color: var(--accent); text-transform: uppercase; font-weight: bold; margin-left: 10px; }

        input {
            width: 100%;
            padding: 12px 20px;
            border-radius: 50px;
            border: 1px solid var(--glass-border);
            background: var(--glass);
            color: white;
            backdrop-filter: blur(10px);
            outline: none;
            box-sizing: border-box;
        }

        input[type="date"]::-webkit-calendar-picker-indicator {
            filter: invert(1);
            cursor: pointer;
        }

        button#fetchBtn {
            align-self: flex-end;
            padding: 12px 25px;
            border-radius: 50px;
            border: none;
            background: var(--accent);
            color: var(--bg);
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

        button#fetchBtn:hover { transform: scale(1.05); opacity: 0.9; }

        .dashboard { width: 100%; max-width: 800px; }

        .card {
            background: var(--glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 35px;
            padding: 30px;
            animation: fadeIn 0.5s ease-out;
        }

        @keyframes fadeIn { from { opacity: 0; transform: scale(0.95); } }

        .card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;}
